# Configuration for the current rpg-librarian application.
# In a source checkout, copy this file to .env at the repository root.
# Existing environment variables win. Normal CLI/MCP launches from this checkout
# find .env by searching upward from app code, regardless of working directory.
# For an installed copy outside this checkout, provide its settings explicitly.

# Catalog path precedence: --catalog, then this variable, then ./catalog.db.
# The library root is registered by init --library; staging roots by add-source.
# RPG_LIBRARIAN_CATALOG=/absolute/path/to/catalog.db

# DriveThruRPG enrichment (source dtrpg). Skipped without an application API key.
# DTRPG_API_KEY=...

# RPGGeek enrichment (source rpggeek). A bearer token is required.
# Uses boardgamegeek.com's XML API, which serves RPG items; a BGG token works.
# RPGGEEK_BEARER_TOKEN=...

# Google search evidence through Serper.dev (source google). Skipped without a key.
# SERPER_API_KEY=...

# Optional Google Books ISBN lookup before Open Library and Wikidata (source isbn).
# GOOGLE_BOOKS_API_KEY=...

# LiteLLM model used by text analysis and find-packs.
# Current default: gpt-5.6-luna.
# RPG_LIBRARIAN_LLM_MODEL=...

# Set the credentials required by the selected model's provider.
# OPENAI_API_KEY=...
# ANTHROPIC_API_KEY=...

# Development only: target for direct Alembic CLI invocations.
# Application commands always migrate their resolved catalog path instead.
# DATABASE_URL=sqlite:////absolute/path/to/catalog.db

# Brendan OneDrive setup. Used by the private preflight helpers now; the planned
# importer will use the same keys. Private preflight helpers load this .env
# explicitly; normal CLI/MCP launches use the application dotenv loader.
# Delegated public-client authentication needs no client secret.
# RPG_LIBRARIAN_ONEDRIVE_CLIENT_ID=...
# RPG_LIBRARIAN_ONEDRIVE_AUTHORITY=https://login.microsoftonline.com/consumers
# RPG_LIBRARIAN_ONEDRIVE_SCOPES="https://graph.microsoft.com/Files.Read.All https://graph.microsoft.com/User.Read"
# RPG_LIBRARIAN_ONEDRIVE_TOKEN_CACHE=/absolute/private/path/msal-cache.json
# RPG_LIBRARIAN_ONEDRIVE_DRIVE_ID=...
# RPG_LIBRARIAN_ONEDRIVE_ROOT_ITEM_ID=...

# Gmail SMTP review digests. Used by the private setup probe now; the importer
# mail adapter is planned. Use a Google app password, not your account password.
# RPG_LIBRARIAN_SMTP_HOST=smtp.gmail.com
# RPG_LIBRARIAN_SMTP_PORT=465
# RPG_LIBRARIAN_SMTP_TLS=ssl
# RPG_LIBRARIAN_SMTP_USERNAME=your-google-email-address
# RPG_LIBRARIAN_SMTP_PASSWORD=your-google-app-password
# RPG_LIBRARIAN_REVIEW_EMAIL_TO=your-digest-recipient
