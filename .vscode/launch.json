{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "debugpy",
            "request": "launch",
            "module": "rpg_librarian",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "envFile": "${workspaceFolder}/.env",
            "name": "MCP server",
            "args": [
                "serve",
                "--catalog",
                "${input:catalog}"
            ]
        },
        {
            "type": "debugpy",
            "request": "launch",
            "module": "rpg_librarian",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "envFile": "${workspaceFolder}/.env",
            "name": "CLI: scan staging root",
            "args": [
                "scan",
                "--root",
                "${input:root}",
                "--catalog",
                "${input:catalog}"
            ]
        },
        {
            "type": "debugpy",
            "request": "launch",
            "module": "rpg_librarian",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "envFile": "${workspaceFolder}/.env",
            "name": "CLI: enrich",
            "args": [
                "enrich",
                "--catalog",
                "${input:catalog}"
            ]
        },
        {
            "type": "debugpy",
            "request": "launch",
            "module": "rpg_librarian",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "envFile": "${workspaceFolder}/.env",
            "name": "CLI: list unfiled",
            "args": [
                "list-unfiled",
                "--catalog",
                "${input:catalog}"
            ]
        },
        {
            "type": "debugpy",
            "request": "launch",
            "module": "rpg_librarian",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "envFile": "${workspaceFolder}/.env",
            "name": "CLI: preview reorganization",
            "args": [
                "reorganize",
                "--dry-run",
                "--catalog",
                "${input:catalog}"
            ]
        },
        {
            "type": "debugpy",
            "request": "launch",
            "module": "rpg_librarian",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "envFile": "${workspaceFolder}/.env",
            "name": "CLI: custom arguments",
            "args": "${command:pickArgs}"
        },
        {
            "name": "Existing tools tests",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "cwd": "${workspaceFolder}",
            "args": [
                "-s",
                "packages/rpg-librarian-tools/tests"
            ],
            "console": "integratedTerminal"
        }
    ],
    "inputs": [
        {
            "id": "catalog",
            "type": "promptString",
            "description": "Absolute path to the current rpg-librarian catalog",
            "default": "${workspaceFolder}/catalog.db"
        },
        {
            "id": "root",
            "type": "promptString",
            "description": "Absolute path to an already registered staging root"
        }
    ]
}
